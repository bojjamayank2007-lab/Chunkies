/* Menu Filters */
.menu-filters {
    margin-bottom: 40px;
}

.filter-categories {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 24px;
}

.filter-btn {
    padding: 10px 24px;
    background-color: var(--bg-card);
    color: var(--white);
    border: 1px solid var(--border-color);
    border-radius: 30px;
    cursor: pointer;
    transition: var(--transition);
    font-weight: 600;
    font-size: 14px;
}

.filter-btn:hover,
.filter-btn.active {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
}

.filter-search {
    max-width: 400px;
    margin: 0 auto 24px;
    position: relative;
}

.filter-search input {
    width: 100%;
    padding: 14px 48px 14px 16px;
    border: 2px solid var(--border-color);
    border-radius: 8px;
    background-color: var(--bg-card);
    color: var(--white);
    font-size: 16px;
}

.filter-search i {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-light);
}

.filter-sort {
    max-width: 200px;
    margin: 0 auto;
}

.filter-sort select {
    width: 100%;
    padding: 12px 16px;
    border: 2px solid var(--border-color);
    border-radius: 8px;
    background-color: var(--bg-card);
    color: var(--white);
    font-size: 14px;
    cursor: pointer;
}

/* Menu Section */
.menu-section {
    background-color: var(--bg-darker);
}

/* About Section */
.about-section {
    background-color: var(--bg-dark);
}

.about-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
}

.about-text h2 {
    font-size: 36px;
    margin-bottom: 24px;
}

.about-text p {
    color: var(--text-light);
    margin-bottom: 20px;
    line-height: 1.8;
}

.about-highlights {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 40px;
}

.highlight {
    text-align: center;
    padding: 24px;
    background-color: var(--bg-card);
    border-radius: 12px;
    border: 1px solid var(--border-color);
}

.highlight i {
    font-size: 32px;
    color: var(--primary-color);
    margin-bottom: 16px;
}

.highlight h3 {
    font-size: 18px;
    margin-bottom: 8px;
}

.highlight p {
    color: var(--text-light);
    font-size: 14px;
}

.about-image {
    display: flex;
    justify-content: center;
}

.image-placeholder {
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1;
    background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-card-hover) 100%);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-color);
}

.image-placeholder i {
    font-size: 64px;
    color: var(--text-light);
    margin-bottom: 16px;
}

.image-placeholder span {
    color: var(--text-light);
    font-size: 18px;
}

/* Services Section */
.services-section {
    background-color: var(--bg-darker);
}

.services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.service-card {
    text-align: center;
    padding: 32px;
    background-color: var(--bg-card);
    border-radius: 16px;
    border: 1px solid var(--border-color);
    transition: var(--transition);
}

.service-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow);
    border-color: var(--primary-color);
}

.service-card i {
    font-size: 48px;
    color: var(--primary-color);
    margin-bottom: 16px;
}

.service-card h3 {
    font-size: 24px;
    margin-bottom: 12px;
}

.service-card p {
    color: var(--text-light);
}

/* Contact Section */
.contact-section {
    background-color: var(--bg-dark);
}

.contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
}

.contact-info h2 {
    font-size: 36px;
    margin-bottom: 32px;
}

.contact-item {
    display: flex;
    gap: 20px;
    margin-bottom: 32px;
}

.contact-item i {
    font-size: 24px;
    color: var(--primary-color);
    margin-top: 4px;
}

.contact-item h3 {
    font-size: 18px;
    margin-bottom: 8px;
}

.contact-item p {
    color: var(--text-light);
    line-height: 1.6;
}

.contact-buttons {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
}

.contact-buttons .btn {
    display: flex;
    align-items: center;
    gap: 8px;
}

.contact-map {
    min-height: 400px;
}

.map-placeholder {
    width: 100%;
    height: 100%;
    min-height: 400px;
    background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-card-hover) 100%);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-color);
    text-align: center;
}

.map-placeholder i {
    font-size: 64px;
    color: var(--text-light);
    margin-bottom: 16px;
}

.map-placeholder h3 {
    font-size: 24px;
    margin-bottom: 8px;
}

.map-placeholder p {
    color: var(--text-light);
    margin-bottom: 24px;
}

/* Checkout Section */
.checkout-section {
    background-color: var(--bg-dark);
}

.checkout-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
}

.order-summary {
    background-color: var(--bg-card);
    padding: 32px;
    border-radius: 16px;
    border: 1px solid var(--border-color);
}

.order-summary h2 {
    font-size: 28px;
    margin-bottom: 24px;
}

.checkout-form {
    background-color: var(--bg-card);
    padding: 32px;
    border-radius: 16px;
    border: 1px solid var(--border-color);
}

.checkout-form h2 {
    font-size: 28px;
    margin-bottom: 24px;
}

.order-totals {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border-color);
}

.total-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
    color: var(--text-light);
}

.total-row.total {
    font-size: 24px;
    font-weight: 700;
    color: var(--white);
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border-color);
}

.total-row.total span:last-child {
    color: var(--primary-color);
}


@media (max-width: 600px) {
    .contact-grid {
        grid-template-columns: 1fr;
        gap: 24px;
    }
}

@media (max-width: 360px) {
    .nav-actions {
        gap: 4px;
    }

    .nav-profile-area {
        gap: 4px;
    }

    .customer-name {
        max-width: 60px;
        font-size: 11px;
    }

    .nav-login-btn {
        padding: 8px 10px;
        font-size: 11px;
    }

    .cart-btn {
        padding: 6px;
        font-size: 18px;
    }
}

@media (max-width: 992px) {
  .navbar .container { gap: 12px; }
  .brand { font-size: 24px; }
  .nav-menu { gap: 16px; }
}

